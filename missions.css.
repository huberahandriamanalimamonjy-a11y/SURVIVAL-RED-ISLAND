#missionMenu {
  position: fixed;
  inset: 0;
  z-index: 110;
  display: none;
  overflow-y: auto;
  padding: 20px;
  background: linear-gradient(135deg, #101b16, #293d2d);
  color: white;
  font-family: Arial, sans-serif;
}

#missionMenu h2 {
  color: #e4c36e;
  text-align: center;
}

.mission-card {
  max-width: 600px;
  margin: 12px auto;
  padding: 15px;
  background: #263b30;
  border: 1px solid #657b59;
  border-radius: 12px;
}

.mission-card h3 {
  color: #e4c36e;
}

.mission-card p {
  font-size: 14px;
}

.mission-progress {
  color: #a9d69c;
  font-weight: bold;
}

#closeMissions {
  display: block;
  margin: 20px auto;
  padding: 12px 25px;
  border: 0;
  border-radius: 8px;
  background: #c49a43;
  font-weight: bold;
}