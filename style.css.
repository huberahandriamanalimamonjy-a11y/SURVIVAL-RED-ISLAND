* {
  box-sizing: border-box;
}

body {
  margin: 0;
  overflow: hidden;
  background: #101a18;
  color: white;
  font-family: Arial, sans-serif;
}

/* MENU PRINCIPAL */
#menu {
  position: absolute;
  z-index: 5;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 20px;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,.75),
    rgba(10,30,20,.9)
  );
}

h1 {
  color: #e44b36;
  font-size: clamp(28px, 7vw, 55px);
  text-shadow: 0 3px 15px black;
}

#playButton {
  padding: 16px 42px;
  border: 2px solid #e44b36;
  border-radius: 8px;
  background: #a51f19;
  color: white;
  font-size: 20px;
  font-weight: bold;
}

#playButton:active {
  transform: scale(.96);
}

#status {
  color: #ddd;
  margin-top: 22px;
}

/* INTERFACE DE SURVIE */
#survivalUI {
  position: fixed;
  top: 20px;
  left: 20px;
  z-index: 10;
  display: none;
  width: 190px;
  padding: 12px;
  background: rgba(0, 0, 0, 0.7);
  border: 1px solid #777;
  border-radius: 10px;
}

.stat {
  font-size: 14px;
  font-weight: bold;
}

.bar {
  width: 100%;
  height: 13px;
  margin-top: 7px;
  background: #444;
  border-radius: 10px;
  overflow: hidden;
}

#healthFill {
  width: 100%;
  height: 100%;
  background: #df3030;
  transition: width .3s;
}

canvas {
  display: block;
  width: 100%;
  height: 100%;
}