* {
  box-sizing: border-box;
}

body {
  margin: 0;
  overflow: hidden;
  background: #101a18;
  color: white;
  font-family: Arial, sans-serif;
}

#menu {
  position: absolute;
  z-index: 5;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 20px;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,.75),
    rgba(10,30,20,.9)
  );
}

h1 {
  color: #e44b36;
  font-size: clamp(28px, 7vw, 55px);
  text-shadow: 0 3px 15px black;
}

#playButton {
  padding: 16px 42px;
  border: 2px solid #e44b36;
  border-radius: 8px;
  background: #a51f19;
  color: white;
  font-size: 20px;
  font-weight: bold;
}

#playButton:active {
  transform: scale(.96);
}

#status {
  color: #ddd;
  margin-top: 22px;
}

canvas {
  display: block;
  width: 100%;
  height: 100%;
}